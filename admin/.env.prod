# app title
VITE_APP_TITLE=Forge Admin

# app base url锛堟瀯寤哄悗 Admin 鎸傝浇浜?/admin/ 瀛愯矾寰勶紝缃戝叧 strip 鍓嶅紑锛?
VITE_BASE_URL=/admin/

# icon prefix
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local

# backend service base url, prod environment (empty = same origin, API proxied by nginx)
VITE_SERVICE_BASE_URL=

# auth route mode: static (no backend route endpoint needed)
VITE_AUTH_ROUTE_MODE=static
VITE_STATIC_SUPER_ROLE=super_admin
VITE_ROUTE_HOME=dashboard

# other backend service base url, prod environment
VITE_OTHER_SERVICE_BASE_URL={}