# Forge Shop Backend Configuration
# Copy to .env and fill in values
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/forge
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
DEBUG=true
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REGION=na
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# 启用的支付渠道（逗号分隔），未配置凭证的渠道不会在 C 端展示
FORGE_PAYMENT_ENABLED_CHANNELS=stripe,paypal,mock
MCP_API_KEY_HASH=  # SHA-256 hash of MCP API key, generate with: echo -n "your-key" | sha256sum
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=product-images

